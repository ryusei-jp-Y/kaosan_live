{
  "name": "kaosan_live",
  "version": "0.1.0",
  "private": true,
  "description": "Line-art avatar lip-sync desktop app for OBS Virtual Camera workflows.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron": "^40.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "wait-on": "^7.2.0"
  }
}
