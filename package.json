{
  "name": "kaosan_live",
  "version": "0.1.0",
  "private": true,
  "description": "Line-art avatar lip-sync desktop app for OBS Virtual Camera workflows.",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.18.0 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.18.0 <27",
      "onFail": "warn"
    }
  },
  "volta": {
    "node": "24.18.0",
    "pnpm": "11.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "check": "pnpm run typecheck && pnpm run build && pnpm run syntaxcheck",
    "start": "electron .",
    "syntaxcheck": "node --check electron/main.cjs && node --check electron/preload.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron": "^40.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "wait-on": "^7.2.0"
  }
}
